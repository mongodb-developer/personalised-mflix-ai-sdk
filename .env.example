# MongoDB Atlas connection string. Load the Atlas sample dataset so sample_mflix.movies exists.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster-url>/?retryWrites=true&w=majority"
MFLIX_DB_NAME="sample_mflix"
MEMORY_DB_NAME="personalised_mflix_memory"

# Gemini via Vercel AI SDK Google provider.
GOOGLE_GENERATIVE_AI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash"

# VoyageAI embeddings for @mongodb-developer/vercel-ai-memory.
VOYAGE_API_KEY=""
VOYAGE_EMBEDDING_MODEL="voyage-3.5"